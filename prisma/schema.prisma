// GOS-22 — first real domain persistence schema for goservice-backend.
//
// Scope note: Prisma is used here as an explicitly human-authorized
// deviation from the "ORM is TBD, needs its own ADR" stance in
// goservice-docs/architecture/backend.md and ADR 0003's open questions —
// see the GOS-22 implementation plan ("Decisiones y discrepancias", #6) for
// the rationale. A follow-up ADR formalizing Prisma as the project's ORM is
// recommended but not created as part of this change.
//
// This schema lives in its own `src/prisma/` module, separate from the
// pre-existing infra-only `src/database/` (plain `pg.Pool`, health-check
// only) — see `src/prisma/prisma.service.ts` for the contrast.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  APPLE
}

// Identity Verification (Didit integration) — retroactive typing of
// CustomerProfile.country/ProfessionalProfile.country, previously a bare
// `String @default("AR")` (GOS-28). Promoted to a real enum because a
// downstream feature (IdentityVerification.country, below) needed a safe,
// closed set of values a free-text String could never guarantee. Starts
// with AR/CO (GoService's initial market + the first confirmed expansion
// target); adding a new country is a pure additive migration
// (`ALTER TYPE ... ADD VALUE`), never a breaking one.
//
// A former per-country `identity.routing.<country>.enabled`
// `PlatformSetting` gate (that `IdentityVerificationProviderRegistry.resolve`
// used to branch on this value to build) was REMOVED (2026-08-15,
// human-requested simplification) — see that class's own header comment:
// Didit is the sole provider and already covers every `CountryCode`, so
// only two GLOBAL kill switches remain (`identity.enabled`/
// `identity.didit.enabled`), and `country` is no longer used to gate
// anything, only to record which country an attempt was for.
enum CountryCode {
  AR
  CO
}

// Account approval status. PENDING_APPROVAL is actively assigned today: the
// first CustomerProfile OR ProfessionalProfile ever created for a User
// (whichever comes first — see ProfilesRepository.upsertCustomerProfile/
// upsertProfessionalProfile) atomically transitions the account from
// EMAIL_VERIFIED to PENDING_APPROVAL. APPROVED/REJECTED are assignable
// today too, but only via the platform-admin `updateUserAccount` manual
// review mutation (an interim mechanism pending a real KYC/identity
// verification vendor) — see
// goservice-docs/decisions/DEC-006-account-identity-verification.md.
enum UserAccountStatus {
  PENDING_EMAIL_VERIFICATION
  EMAIL_VERIFIED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model User {
  id                      String            @id @default(uuid()) @db.Uuid
  firstName               String?
  lastName                String?
  email                   String            @unique
  // Null forever for social accounts (service-level rule, not a DB
  // constraint — a CHECK constraint was considered and deliberately skipped
  // as unnecessary ceremony for this story's scope).
  passwordHash            String?
  phoneCountryCode        String?
  phoneNumber             String?
  dateOfBirth             DateTime?         @db.Date
  acceptedTermsAndPrivacy Boolean           @default(false)
  authProvider            AuthProvider
  socialProviderSubject   String?
  accountStatus           UserAccountStatus @default(PENDING_EMAIL_VERIFICATION)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  emailVerificationCodes             EmailVerificationCode[]
  sessions                           Session[]
  passwordResetCodes                 PasswordResetCode[]
  // GOS-14/GOS-28 — first business-domain entities. A User may hold both at
  // once (no exclusivity rule): see profiles.repository.ts.
  customerProfile                    CustomerProfile?
  professionalProfile                ProfessionalProfile?
  // Identity Verification (Didit) — 1:N, a User may have more than one
  // attempt (e.g. an earlier session was Abandoned). See
  // `src/identity-verification/`.
  identityVerifications              IdentityVerification[]
  // GOS-38 — pre-reserved attachment upload slots (see
  // ServiceRequestAttachmentUploadRef below). Purely additive, no new
  // column on this table.
  serviceRequestAttachmentUploadRefs ServiceRequestAttachmentUploadRef[]

  // Non-unique: real uniqueness is enforced by the `email` unique
  // constraint above. This index only speeds up the socialLogin fast-path
  // lookup by (authProvider, socialProviderSubject).
  @@index([authProvider, socialProviderSubject])
}

// GOS-7 — login/socialLogin/logout session mechanism. This is an explicit,
// reversible product-level decision (NOT an ADR): opaque bearer token,
// SHA-256-hashed at rest, no JWT/Redis/cookies/external provider — see the
// GOS-7 implementation plan's "Decisiones tomadas" for the rationale. The
// final session mechanism remains TBD at the architecture level.
enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 hash of the opaque session token (`crypto.randomBytes(32)`,
  // base64url) — mirrors `EmailVerificationCode.codeHash`'s hash-at-rest
  // pattern. The plaintext token is returned to the caller exactly once,
  // at creation, and is never persisted anywhere.
  tokenHash String        @unique
  status    SessionStatus @default(ACTIVE)

  // Reserved, unused in this story (no device/session-management UI yet).
  deviceLabel String?

  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  // Reserved for a future idle-timeout/Face ID re-auth story — set at
  // creation only in GOS-7, never updated on read.
  lastActivityAt DateTime  @default(now())
  revokedAt      DateTime?

  @@index([userId, status])
}

model EmailVerificationCode {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the 6-digit code, deliberately NOT argon2/a slow KDF —
  // see goservice-backend/src/users/services/register-user.service.ts for
  // the documented rationale (attemptsCount + expiry + throttling are the
  // real controls for a 6-digit space).
  codeHash      String
  expiresAt     DateTime
  attemptsCount Int       @default(0)
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, consumedAt, invalidatedAt])
}

// GOS-9 — forgot-password 6-digit code, a near-1:1 structural mirror of
// `EmailVerificationCode` above (same hash-at-rest/attempts/expiry/
// single-use pattern), but modeled as its own entity rather than reusing
// `EmailVerificationCode` with a "kind" discriminator — mixing two
// unrelated lifecycles (new-account email verification vs. an existing
// account's credential recovery) in one table would blur a distinction the
// schema already models per-entity elsewhere. See
// goservice-backend/docs/gos9-plan-tecnico.md §5.2.
model PasswordResetCode {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the 6-digit code — same rationale as
  // `EmailVerificationCode.codeHash` above.
  codeHash      String
  expiresAt     DateTime
  attemptsCount Int       @default(0)
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, consumedAt, invalidatedAt])
}

// GOS-14/GOS-28 — first GoService business-domain entities (not Identity).
// CustomerProfile/ProfessionalProfile/Category are the foundation
// ServiceRequest, Quote, Engagement, and Professional Discovery build on.

// Professional identity-document verification status. Mirrors
// UserAccountStatus's reserved-values pattern: this story only ever assigns
// UNVERIFIED (always, on creation) — PENDING_REVIEW/VERIFIED/REJECTED are
// reserved for a future Identity Verification story and must exist now so
// that story needs no breaking schema change. Never assigned or mutated by
// any GraphQL mutation in this story.
enum ProfessionalVerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

// Read-only service catalog. No CRUD, no GraphQL mutation — seeded only via
// prisma/seed.ts (`npm run prisma:seed`). Referenced by ProfessionalProfile
// via the explicit ProfessionalSpecialization join below.
model Category {
  id           String @id @default(uuid()) @db.Uuid
  name         String @unique
  // Admin-managed catalog ordering (2026-08-18 follow-up) — every place
  // that lists categories (public `categories`, admin `serviceRequestCategories`/
  // `adminCategories`) sorts `[{ displayOrder: 'asc' }, { name: 'asc' }]`, so
  // the name is only ever the tiebreaker, never the primary sort. Plain
  // `Int`, not `@unique` — ties are allowed and resolved alphabetically;
  // there is no renumbering transaction needed when an admin moves one
  // category, only when they explicitly want to.
  displayOrder Int    @default(0)

  // Category tree (2026-08-18 follow-up) — nullable self-relation, `null`
  // means "root-level category" (every pre-existing row, and the common
  // case). Unlimited depth — nothing in this schema caps it, the admin UI
  // is what keeps real-world usage shallow. `onDelete: Restrict`: Postgres
  // itself refuses to delete a Category that still has children, on top of
  // (not instead of) the application-level `CATEGORY_IN_USE` pre-check
  // `DeleteCategoryService` already does for a clean error message — same
  // "defense in depth, not just a UI filter" instinct as this codebase's
  // other FK `Restrict`s.
  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professionalProfiles ProfessionalSpecialization[]
  // GOS-38 — purely additive back-reference, no new column here.
  serviceRequests      ServiceRequest[]

  // Postgres does not index FKs automatically (only unique constraints) —
  // declared explicit, same lesson as every other FK column in this schema.
  // Supports both tree-traversal reads (children of a given parent) and the
  // `onDelete: Restrict` check itself.
  @@index([parentId])
}

model CustomerProfile {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @unique @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  addressLine String
  city        String
  province    String
  // Defaults to Argentina — GoService's initial market — anticipating the
  // documented later expansion to Latin America without a future migration.
  // A real CountryCode enum (not a bare String) since Identity Verification
  // (`src/identity-verification/`) branches on this value — see that
  // enum's own header comment above. Retroactively migrated from
  // `String @default("AR")` — see
  // `prisma/migrations/*_convert_country_to_enum/migration.sql`'s own
  // comment for the `USING country::"CountryCode"` cast this required.
  country     CountryCode @default(AR)
  // Reference to an externally-stored image (no object-storage provider is
  // decided yet — see infrastructure.md's open hosting-provider question —
  // so this is just a URL string today, not backed by any real upload flow).
  photoUrl    String?
  // Proximity Discovery (ADR 0006 / DEC-005) — geocoded server-side from the address above.
  // Owner-only; never exposed on the GraphQL type.
  addressLatitude  Float?
  addressLongitude Float?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // GOS-38 — purely additive back-reference, no new column here.
  serviceRequests             ServiceRequest[]
  // GOS-41 — purely additive back-reference, no new column here.
  // Deliberately denormalized on Engagement itself (also derivable via
  // serviceRequest.customerProfileId) — see Engagement's own header
  // comment for why.
  engagements                 Engagement[]
  // GOS-53 — purely additive back-references, no new column here. A
  // CustomerProfile may author negotiation messages/proposals, and may be
  // the resolving party on a proposal a Professional made.
  authoredNegotiationMessages QuoteNegotiationMessage[]
  proposedPriceProposals      QuotePriceProposal[]      @relation("QuotePriceProposalProposedByCustomer")
  resolvedPriceProposals      QuotePriceProposal[]      @relation("QuotePriceProposalResolvedByCustomer")
  // GOS-46 — purely additive back-reference, no new column here. A
  // CustomerProfile may send Engagement Chat messages as one of the two
  // parties on an Engagement.
  sentEngagementChatMessages  EngagementChatMessage[]
  // GOS-59 — purely additive back-reference, no new column here. A
  // CustomerProfile may be the proposing party on an Appointment.
  proposedAppointments        Appointment[]

  // @unique(userId) above is the physical "one CustomerProfile per User"
  // constraint the story requires — upsertCustomerProfile always targets
  // where: { userId }.
  @@index([country, city])
}

model ProfessionalProfile {
  id                     String                         @id @default(uuid()) @db.Uuid
  userId                 String                         @unique @db.Uuid
  user                   User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName            String
  // Structured city/country (as opposed to only the free-text
  // serviceAreaDescription below) anticipates Professional Discovery
  // needing to filter/index by category+city without a future migration.
  city                   String
  // Real CountryCode enum — see CustomerProfile.country's own comment above
  // for the full rationale (retroactive String -> enum migration).
  country                CountryCode                    @default(AR)
  serviceAreaDescription String
  bio                    String
  // Same caveat as CustomerProfile.photoUrl — a URL string, no real upload
  // flow/storage provider decided yet.
  photoUrl               String?
  // Self-declared, optional appeal/credibility field — distinct from
  // verificationStatus below, which is the trust/safety approval gate.
  // Not reviewed or moderated. (yearsOfExperience deliberately does NOT
  // live here — it lives per-specialization below, on
  // ProfessionalSpecialization, so a senior electrician who also does
  // some plumbing can report different experience for each.)
  languages              String[]                       @default([])
  verificationStatus     ProfessionalVerificationStatus @default(UNVERIFIED)
  // Proximity Discovery (ADR 0006 / DEC-005) — declared Service Area centre + radius.
  // EXACT pair, owner-only (Query.myServiceArea); never on the public GraphQL type.
  serviceAreaLatitude  Float?
  serviceAreaLongitude Float?
  // How far (km) this Professional will travel from the Service Area centre. Public.
  serviceAreaRadiusKm  Int?
  // APPROXIMATE pair — snapped to a ~500m grid, the only coordinates ever exposed pre-Engagement.
  approximateLatitude  Float?
  approximateLongitude Float?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  specializations             ProfessionalSpecialization[]
  // GOS-41 — purely additive back-references, no new column here.
  quotes                      Quote[]
  // Deliberately denormalized on Engagement itself (also derivable via
  // quote.professionalProfileId) — see Engagement's own header comment for
  // why.
  engagements                 Engagement[]
  // GOS-53 — purely additive back-references, no new column here. A
  // ProfessionalProfile may author negotiation messages/proposals, and may
  // be the resolving party on a proposal a Customer made.
  authoredNegotiationMessages QuoteNegotiationMessage[]
  proposedPriceProposals      QuotePriceProposal[]         @relation("QuotePriceProposalProposedByProfessional")
  resolvedPriceProposals      QuotePriceProposal[]         @relation("QuotePriceProposalResolvedByProfessional")
  // GOS-46 — purely additive back-reference, no new column here. A
  // ProfessionalProfile may send Engagement Chat messages as one of the two
  // parties on an Engagement.
  sentEngagementChatMessages  EngagementChatMessage[]
  // GOS-59 — purely additive back-references, no new column here. Two
  // distinct relations into Appointment (same "two distinct FKs into
  // ProfessionalProfile require named relations" precedent as
  // QuotePriceProposal.proposedByProfessionalProfile/
  // resolvedByProfessionalProfile above): every Appointment on an
  // Engagement this ProfessionalProfile is the party of (denormalized,
  // regardless of who proposed it), and, separately, every Appointment this
  // ProfessionalProfile itself proposed.
  appointments                 Appointment[]                @relation("AppointmentProfessional")
  proposedAppointments         Appointment[]                @relation("AppointmentProposedByProfessional")

  // @unique(userId) above is the physical "one ProfessionalProfile per
  // User" constraint. Indexes anticipate Discovery (country+city) and a
  // future Identity Verification queue (verificationStatus).
  @@index([country, city])
  @@index([verificationStatus])
  // Proximity Discovery's bounding-box prefilter (ADR 0006 decision 10).
  @@index([approximateLatitude, approximateLongitude])
}

// Which trade a professional's specialization is: their main one, or an
// additional one they also do. Exactly one PRIMARY per professional is
// enforced at the application layer (UpsertProfessionalProfileService) —
// see that class's assertExactlyOnePrimary.
enum SpecializationRole {
  PRIMARY
  SECONDARY
}

// Explicit join table (deliberately not an implicit Prisma many-to-many),
// now the realization of the "Skill" concept this comment used to only
// anticipate: each row is one of a professional's trades, with its own
// description/experience/role/display-order — not just a bare category
// reference. A senior electrician who also does some plumbing reports
// different description/yearsOfExperience for each. The composite @@id
// below is the physical "no duplicate category per professional"
// constraint the story requires.
model ProfessionalSpecialization {
  professionalProfileId String              @db.Uuid
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  categoryId            String              @db.Uuid
  // Restrict, not Cascade: Category is a read-only seeded catalog: nothing
  // should ever be able to delete a Category still referenced by a
  // professional (defensive — no delete path exists anywhere in this story).
  category              Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  role                  SpecializationRole
  // Required on every specialization, primary and secondary alike — no
  // "empty" specialization that tells a customer nothing (confirmed
  // product decision).
  description           String
  yearsOfExperience     Int?
  // Server-derived from the submitted array's position at upsert time —
  // never client-managed as an arbitrary integer — so future
  // filtering/ranking has a stable display order without duplicate/gap
  // bookkeeping. See ProfilesRepository.upsertProfessionalProfile.
  order                 Int                 @default(0)
  createdAt             DateTime            @default(now())

  @@id([professionalProfileId, categoryId])
  // Anticipates Professional Discovery's "find professionals in category X".
  @@index([categoryId])
}

// GOS-38 — first ServiceRequest-side domain entities. A ServiceRequest
// belongs to exactly one CustomerProfile (Confirmed rule —
// goservice-docs/product/business-rules.md) and references exactly one
// Category.
//
// GOS-41 — Quote/Engagement (goservice-docs/architecture/domain-model.md)
// are now real, modeled below (they used to be hypotheses only — see the
// GOS-38 plan's "Future Quote compatibility" section for the shape that
// section anticipated, which this mostly follows).

// OPEN while visible to compatible Professionals and open to new Quotes;
// CANCELLED once the owning Customer cancels it (only ever possible while
// still OPEN — see ServiceRequestsRepository.cancel()); ENGAGED
// (GOS-41 addition) once one of its Quotes has been accepted — an active
// Engagement now exists (see ServiceRequest.engagement below). Both
// CANCELLED and ENGAGED are terminal — neither ever reverts to OPEN. Adding
// `ENGAGED` here is a pure additive `ALTER TYPE "ServiceRequestStatus" ADD
// VALUE '...'` migration, same "reserved for later, added when the trigger
// exists" posture as ProfessionalVerificationStatus's
// PENDING_REVIEW/VERIFIED/REJECTED.
enum ServiceRequestStatus {
  OPEN
  CANCELLED
  ENGAGED
}

// Proposed by the GOS-38 ticket itself. NOT confirmed against
// goservice-docs/architecture/ubiquitous-language.md or
// product/business-rules.md — no urgency taxonomy is documented anywhere in
// this project. Used as given, without adding extra values, pending
// explicit product sign-off (see the GOS-38 plan's "Decisiones pendientes").
enum ServiceRequestUrgency {
  FLEXIBLE
  THIS_WEEK
  URGENT
}

model ServiceRequest {
  id                  String                @id @default(uuid()) @db.Uuid
  customerProfileId   String                @db.Uuid
  customerProfile     CustomerProfile       @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  categoryId          String                @db.Uuid
  // Restrict, same reasoning as ProfessionalSpecialization.category:
  // Category is a read-only seeded catalog, nothing should ever be able to
  // delete a Category still referenced by a live ServiceRequest.
  category            Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description         String
  urgency             ServiceRequestUrgency
  // "Indicative" only (domain-model.md calls it an "indicative budget
  // range") — both optional, no currency column: currency is implied by
  // CustomerProfile.country (AR->ARS, CO->COP), the same way this schema
  // never models a separate currency column anywhere else.
  indicativeBudgetMin Int?
  indicativeBudgetMax Int?
  status              ServiceRequestStatus  @default(OPEN)
  cancelledAt         DateTime?
  // GOS-41 — set atomically with the OPEN->ENGAGED transition, inside
  // AcceptQuoteService's single transaction (see that service's own header
  // comment). `@unique` here is itself part of the DB-level guarantee that
  // at most one Quote can ever be the accepted one for a given
  // ServiceRequest — a scalar column can only ever point at one value.
  // Named relation ("ServiceRequestAcceptedQuote") because Quote and
  // ServiceRequest also have a SEPARATE, unrelated relation below (every
  // Quote submitted against a ServiceRequest, regardless of status) —
  // Prisma requires an explicit name to disambiguate the two.
  acceptedQuoteId     String?               @unique @db.Uuid
  acceptedQuote       Quote?                @relation("ServiceRequestAcceptedQuote", fields: [acceptedQuoteId], references: [id], onDelete: Cascade)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  attachments          ServiceRequestAttachment[]
  attachmentUploadRefs ServiceRequestAttachmentUploadRef[]
  // GOS-41 — every Quote ever submitted against this ServiceRequest
  // (SENT/WITHDRAWN/REJECTED/ACCEPTED alike), NOT just the accepted one —
  // see Quote.serviceRequest below and acceptedQuote above for that
  // separate, single-row relation.
  quotes               Quote[]                             @relation("ServiceRequestQuotes")
  // GOS-41 — the one Engagement created once a Quote is accepted for this
  // ServiceRequest, if any. Engagement (not ServiceRequest) holds the FK
  // (`Engagement.serviceRequestId @unique`) — see that model below.
  engagement           Engagement?

  // Supports `myPublishedServiceRequests` (WHERE customerProfileId = ?
  // ORDER BY createdAt DESC) without a sort spill. Postgres does NOT
  // auto-index FK columns (only unique constraints get one for free) — same
  // lesson ProfessionalSpecialization's own @@index([categoryId]) already
  // documents.
  @@index([customerProfileId, createdAt])
  // The index `compatibleServiceRequests` needs — see
  // ServiceRequestsRepository.findManyCompatible.
  @@index([status, categoryId])
}

// GOS-41 — a Professional's offer against one OPEN ServiceRequest. SENT is
// the only non-terminal state; WITHDRAWN/REJECTED/ACCEPTED are all
// terminal. REJECTED is used both for an explicit Customer rejection
// (`rejectQuote`) AND for the automatic rejection of every OTHER SENT Quote
// on the same ServiceRequest once one is accepted (`AcceptQuoteService`) —
// deliberately the same value for both triggers, no separate
// "auto-rejected" state (see the GOS-41 plan's decision #2).
//
// Deliberately NO `@@unique([serviceRequestId, professionalProfileId])` —
// whether a Professional may resubmit a Quote after withdrawing an earlier
// one is a genuine open product question, left unenforced at the DB level
// rather than guessed at (see the GOS-41 plan's decision #8).
enum QuoteStatus {
  SENT
  WITHDRAWN
  REJECTED
  ACCEPTED
}

model Quote {
  id                    String              @id @default(uuid()) @db.Uuid
  serviceRequestId      String              @db.Uuid
  // Named relation — see ServiceRequest.quotes/acceptedQuote's own comments
  // for why Quote<->ServiceRequest needs two distinct, explicitly-named
  // relations. Cascade: see this schema's own "GOS-41 onDelete" note on
  // ServiceRequest.customerProfile above and the GOS-41 plan's decision #12
  // — Quote must never block a User/CustomerProfile/ProfessionalProfile/
  // ServiceRequest hard-delete (`deleteUserAccount`/
  // `bulkDeleteUserAccounts`, already implemented and e2e-tested).
  serviceRequest        ServiceRequest      @relation("ServiceRequestQuotes", fields: [serviceRequestId], references: [id], onDelete: Cascade)
  professionalProfileId String              @db.Uuid
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  price                 Int
  // GOS-53 — the negotiated price agreed via the Quote Negotiation thread
  // (`QuoteNegotiationMessage`/`QuotePriceProposal`, below), set ONLY by
  // `AcceptQuotePriceProposalService` inside the same transaction as the
  // `QuotePriceProposal` PENDING -> ACCEPTED CAS write. `price` (the
  // ORIGINAL quoted price) is NEVER written to again once set at
  // `submitQuote` time — `negotiatedPrice` is a separate, additive field,
  // not an overwrite, so the original offer stays visible/auditable
  // alongside whatever was actually agreed.
  negotiatedPrice       Int?
  message               String
  status                QuoteStatus         @default(SENT)
  withdrawnAt           DateTime?
  rejectedAt            DateTime?
  acceptedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Inverse of ServiceRequest.acceptedQuote (named "ServiceRequestAcceptedQuote")
  // — at most one ServiceRequest can ever point at a given Quote as its
  // accepted one. Quote does not hold this FK; ServiceRequest does
  // (`ServiceRequest.acceptedQuoteId`).
  acceptedByServiceRequest ServiceRequest?           @relation("ServiceRequestAcceptedQuote")
  // The Engagement created if/when this Quote is accepted. Engagement holds
  // the FK (`Engagement.quoteId @unique`) — see that model below.
  engagement               Engagement?
  // GOS-53 — every negotiation message/price proposal ever posted against
  // this Quote. Cascade-deleted with the Quote (see
  // QuoteNegotiationMessage/QuotePriceProposal's own onDelete comments) —
  // Quote must never block a hard delete, same rule as every other Quote
  // relation above.
  negotiationMessages      QuoteNegotiationMessage[]
  priceProposals           QuotePriceProposal[]

  // Supports quotesForServiceRequest (WHERE serviceRequestId = ?) and the
  // SENT-only lookups AcceptQuoteService/WithdrawQuoteService/
  // RejectQuoteService all do.
  @@index([serviceRequestId, status])
  // Supports myQuotes (WHERE professionalProfileId = ? ORDER BY createdAt
  // DESC).
  @@index([professionalProfileId, createdAt])
}

// GOS-53 — Quote Negotiation. Who authored a message / made a price
// proposal / resolved one, relative to a specific Quote — ties identity to
// the ROLE the caller is acting in ON THIS QUOTE, not to the User row
// (a User can hold both a CustomerProfile and a ProfessionalProfile at
// once — see User's own header comment — so "which profile acted here"
// must be recorded explicitly, not inferred from the User alone).
enum QuoteNegotiationParty {
  CUSTOMER
  PROFESSIONAL
}

// GOS-53 — one comment (optionally carrying a price proposal) in the
// negotiation thread attached to a Quote. `authorCustomerProfileId`/
// `authorProfessionalProfileId` are a nullable pair — exactly one non-null,
// matching `authorRole` — enforced by a raw-SQL CHECK constraint in the
// migration (`quote_negotiation_message_author_shape_check`), same
// "structural guardrail, not just application-code discipline" precedent as
// `PlatformSetting`'s own `platform_setting_encrypted_shape_check`.
model QuoteNegotiationMessage {
  id         String                @id @default(uuid()) @db.Uuid
  quoteId    String                @db.Uuid
  // Cascade: same "must never block a Quote/ServiceRequest/User hard
  // delete" rule as every other Quote-owned relation in this schema.
  quote      Quote                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  authorRole QuoteNegotiationParty

  authorCustomerProfileId     String?              @db.Uuid
  authorCustomerProfile       CustomerProfile?     @relation(fields: [authorCustomerProfileId], references: [id], onDelete: Cascade)
  authorProfessionalProfileId String?              @db.Uuid
  authorProfessionalProfile   ProfessionalProfile? @relation(fields: [authorProfessionalProfileId], references: [id], onDelete: Cascade)

  message   String
  createdAt DateTime @default(now())

  // The QuotePriceProposal this message created, if the author attached a
  // proposedPrice — 1:1, `negotiationMessageId @unique` lives on
  // QuotePriceProposal (see that model below).
  priceProposal QuotePriceProposal?

  // Supports quoteNegotiationMessages (WHERE quoteId = ? ORDER BY createdAt
  // ASC) — the one lookup this whole capability's read path does.
  @@index([quoteId, createdAt])
}

// GOS-53 — a price counter-offer, always created alongside exactly one
// QuoteNegotiationMessage (the comment that proposed it).
enum QuotePriceProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}

// GOS-53 — `resolvedByCustomerProfileId`/`resolvedByProfessionalProfileId`
// are set ONLY on accept/reject (both null while PENDING/SUPERSEDED) —
// always the COUNTERPARTY of `proposedByRole` (self-resolve is forbidden,
// see QuoteNegotiationAccessService), so no separate `resolvedByRole`
// column is needed: which pair is non-null already says who resolved it.
model QuotePriceProposal {
  id      String @id @default(uuid()) @db.Uuid
  quoteId String @db.Uuid
  // Cascade — same rule as QuoteNegotiationMessage.quote above.
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  // 1:1 with the message that created this proposal. Cascade: a proposal
  // can never outlive the message that created it.
  negotiationMessageId String                  @unique @db.Uuid
  negotiationMessage   QuoteNegotiationMessage @relation(fields: [negotiationMessageId], references: [id], onDelete: Cascade)

  proposedByRole                  QuoteNegotiationParty
  proposedByCustomerProfileId     String?               @db.Uuid
  proposedByCustomerProfile       CustomerProfile?      @relation("QuotePriceProposalProposedByCustomer", fields: [proposedByCustomerProfileId], references: [id], onDelete: Cascade)
  proposedByProfessionalProfileId String?               @db.Uuid
  proposedByProfessionalProfile   ProfessionalProfile?  @relation("QuotePriceProposalProposedByProfessional", fields: [proposedByProfessionalProfileId], references: [id], onDelete: Cascade)

  proposedPrice Int
  status        QuotePriceProposalStatus @default(PENDING)

  resolvedByCustomerProfileId     String?              @db.Uuid
  resolvedByCustomerProfile       CustomerProfile?     @relation("QuotePriceProposalResolvedByCustomer", fields: [resolvedByCustomerProfileId], references: [id], onDelete: Cascade)
  resolvedByProfessionalProfileId String?              @db.Uuid
  resolvedByProfessionalProfile   ProfessionalProfile? @relation("QuotePriceProposalResolvedByProfessional", fields: [resolvedByProfessionalProfileId], references: [id], onDelete: Cascade)
  resolvedAt                      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Supports the "find the current PENDING proposal for this Quote"
  // CAS-supersede lookup PostQuoteNegotiationMessageService does on every
  // new price proposal.
  @@index([quoteId, status])
}

// GOS-41 — deliberately a single value for now (`ACCEPTED`). No
// IN_PROGRESS/COMPLETED/etc. is added speculatively — see the GOS-41 plan's
// decision #6: those states get added when a real trigger for them exists,
// not before, same "reserved for later" posture as
// ProfessionalVerificationStatus/ServiceRequestStatus already establish
// elsewhere in this schema.
enum EngagementStatus {
  ACCEPTED
}

// GOS-41 — created exactly once, atomically, inside AcceptQuoteService's
// transaction, the moment a Quote is accepted. `serviceRequestId`/`quoteId`
// are both `@unique` — a ServiceRequest can have at most one Engagement,
// and a Quote can become at most one Engagement, matching
// ServiceRequestStatus.ENGAGED/QuoteStatus.ACCEPTED both being terminal,
// one-way transitions.
//
// `customerProfileId`/`professionalProfileId` are DELIBERATELY
// denormalized — both are already derivable via
// `serviceRequest.customerProfileId`/`quote.professionalProfileId` — so
// that a future Chat/Notifications module (not built yet — see
// goservice-docs/product/roadmap.md) can query "my Engagements" directly by
// either party without a join through ServiceRequest+Quote. A documented
// trade-off (see the GOS-41 plan's decision #6), not silent duplication.
model Engagement {
  id                    String              @id @default(uuid()) @db.Uuid
  serviceRequestId      String              @unique @db.Uuid
  serviceRequest        ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  quoteId               String              @unique @db.Uuid
  quote                 Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  customerProfileId     String              @db.Uuid
  customerProfile       CustomerProfile     @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  professionalProfileId String              @db.Uuid
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  status                EngagementStatus    @default(ACCEPTED)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // GOS-46 — the one Engagement Chat coordination conversation for this
  // Engagement, if any (created transparently the first time either party
  // sends a message). Engagement does not hold the FK — see
  // EngagementChatConversation.engagementId (`@unique`) below, same
  // "child holds the FK" convention ServiceRequest.engagement/Quote.engagement
  // already establish above.
  chatConversation      EngagementChatConversation?

  // GOS-59 — every Appointment ever proposed/confirmed/cancelled on this
  // Engagement (deliberately NOT a single 1:1 field — see
  // Appointment.engagementId's own comment for why it's not `@unique`).
  appointments          Appointment[]

  // Supports myEngagementsAsCustomer/myEngagementsAsProfessional (WHERE
  // <profile>Id = ? ORDER BY createdAt DESC). serviceRequestId/quoteId
  // above already get a unique index for free from `@unique`.
  @@index([customerProfileId, createdAt])
  @@index([professionalProfileId, createdAt])
}

// GOS-46 — Chat de Coordinación: a free-text coordination thread hung off
// an already-`ACCEPTED` Engagement (schedule/address/materials logistics),
// purely additive — see this pair of models' own comments below for the
// deliberate absence of any structured business field.
//
// **Refinement over `domain-model.md`'s original Conversation/Message
// hypothesis**: that section originally sketched Conversation as hanging
// off `ServiceRequest`. Here it hangs off `Engagement` instead — a
// deliberate, documented refinement (not a silent contradiction): free-form
// coordination chat only makes sense once both parties are already
// committed via an accepted Quote, matching this ticket's own business goal
// ("Cliente y Profesional de un Engagement ya aceptado"). See
// domain-model.md's own updated section for the full writeup.
enum EngagementChatParty {
  CUSTOMER
  PROFESSIONAL
}

// GOS-46 — one per Engagement, created transparently (idempotent upsert
// keyed on the `engagementId @unique` column below) the first time either
// party sends a message via `sendEngagementMessage` — no separate "create
// conversation" mutation exists, or ever will. Mirrors the "idempotent
// upsert keyed on a single unique column" pattern
// `ProfilesRepository.upsertCustomerProfile`/`upsertProfessionalProfile`
// already establish, rather than a hand-rolled unique-constraint-plus-
// catch-and-refetch race handler — Postgres's own `INSERT ... ON CONFLICT`
// (what Prisma's `upsert` compiles to for a single unique key) already
// makes the create-if-missing race atomic and safe.
model EngagementChatConversation {
  id           String     @id @default(uuid()) @db.Uuid
  engagementId String     @unique @db.Uuid
  // Cascade — a coordination conversation can never outlive its Engagement
  // (same "must never block a hard delete" rule every other Engagement-
  // owned/adjacent relation in this schema already follows).
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  messages EngagementChatMessage[]
}

// GOS-46 — one free-text coordination message. `senderCustomerProfileId`/
// `senderProfessionalProfileId` is the same nullable pair (exactly one
// non-null, matching `senderRole`) as `QuoteNegotiationMessage`'s own
// `authorCustomerProfileId`/`authorProfessionalProfileId`, enforced by the
// same kind of raw-SQL CHECK constraint in the migration
// (`engagement_chat_message_sender_shape_check`) — a structural guardrail,
// not just application-code discipline.
//
// Deliberately carries NO structured business field — no price, no status,
// no reference back into `Quote`/`Engagement` state. `content` is the ONLY
// payload field. This is a deliberate divergence from
// `QuoteNegotiationMessage` (which optionally carries a `priceProposal`):
// Engagement Chat is coordination-only and must never become a side channel
// for renegotiating price or engagement state.
model EngagementChatMessage {
  id             String                     @id @default(uuid()) @db.Uuid
  conversationId String                     @db.Uuid
  // Cascade — same rule as EngagementChatConversation.engagement above.
  conversation   EngagementChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole     EngagementChatParty

  senderCustomerProfileId     String?              @db.Uuid
  senderCustomerProfile       CustomerProfile?     @relation(fields: [senderCustomerProfileId], references: [id], onDelete: Cascade)
  senderProfessionalProfileId String?              @db.Uuid
  senderProfessionalProfile   ProfessionalProfile? @relation(fields: [senderProfessionalProfileId], references: [id], onDelete: Cascade)

  content   String
  createdAt DateTime @default(now())

  // Supports engagementMessages (WHERE conversationId = ? ORDER BY
  // createdAt ASC) — the one lookup this whole capability's read path does,
  // same "index the one real query pattern" precedent as
  // QuoteNegotiationMessage's own @@index([quoteId, createdAt]).
  @@index([conversationId, createdAt])
}

// GOS-59 — Appointment (Coordinación de Visita): once an Engagement exists,
// the Customer and Professional formally agree on a date/time for the work.
// Who proposed/confirmed it, relative to a specific Appointment — same
// "role acted in on this entity, not the User row itself" reasoning as
// `QuoteNegotiationParty`/`EngagementChatParty`'s own header comments (a
// User can hold both a `CustomerProfile` and a `ProfessionalProfile` at
// once).
enum AppointmentParty {
  CUSTOMER
  PROFESSIONAL
}

// PENDING (proposed, awaiting the other party) -> CONFIRMED (accepted by the
// non-proposing party) or CANCELLED (either party, from PENDING or
// CONFIRMED). CANCELLED is terminal — never reverts. An Engagement may
// accumulate several Appointment rows over its life (e.g.
// cancel-then-repropose) — see Appointment.engagementId's own comment for
// why that column is deliberately NOT `@unique`.
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// GOS-59 — one proposed/confirmed visit slot on an already-`ACCEPTED`
// Engagement. `engagementId` is deliberately NOT `@unique` — an Engagement
// may accumulate several Appointment rows over its life (cancel then
// repropose a new slot), unlike `EngagementChatConversation.engagementId`
// (1:1 by design).
//
// `proposedByCustomerProfileId`/`proposedByProfessionalProfileId` are the
// same nullable pair (exactly one non-null, matching `proposedByRole`) as
// `QuoteNegotiationMessage.authorCustomerProfileId`/
// `authorProfessionalProfileId` — enforced by a raw-SQL CHECK constraint in
// the migration (`appointment_proposed_by_shape_check`), same "structural
// guardrail, not just application-code discipline" precedent.
//
// Concurrency: a `CONFIRMED` Appointment must truly block the Professional's
// calendar. The guarded-CAS idiom this codebase already uses elsewhere
// (`AppointmentsRepository.confirmIfPending`) only protects ONE row's own
// PENDING->CONFIRMED transition — it cannot prevent TWO DIFFERENT
// Appointment rows being confirmed concurrently for overlapping times on the
// same professional. The real guarantee is the raw-SQL `EXCLUDE USING gist`
// constraint added in the migration
// (`appointment_no_overlapping_confirmed_per_professional`) — the first
// EXCLUDE-constraint precedent in this codebase, scoped to `CONFIRMED` rows
// only (two `PENDING` proposals for the same professional may overlap; only
// a `CONFIRMED` slot is a real commitment).
model Appointment {
  id           String     @id @default(uuid()) @db.Uuid
  engagementId String     @db.Uuid
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  // Denormalized from engagement.professionalProfileId at create time —
  // same rationale as Engagement's own denormalized profile ids: lets the
  // raw-SQL EXCLUDE constraint filter per-professional without a join.
  professionalProfileId String              @db.Uuid
  professionalProfile   ProfessionalProfile @relation("AppointmentProfessional", fields: [professionalProfileId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime
  status   AppointmentStatus @default(PENDING)

  proposedByRole                  AppointmentParty
  proposedByCustomerProfileId     String?              @db.Uuid
  proposedByCustomerProfile       CustomerProfile?     @relation(fields: [proposedByCustomerProfileId], references: [id], onDelete: Cascade)
  proposedByProfessionalProfileId String?              @db.Uuid
  proposedByProfessionalProfile   ProfessionalProfile? @relation("AppointmentProposedByProfessional", fields: [proposedByProfessionalProfileId], references: [id], onDelete: Cascade)

  cancelReason String?
  cancelledAt  DateTime?
  confirmedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([engagementId, createdAt])
  @@index([professionalProfileId, status])
}

model ServiceRequestAttachment {
  id               String         @id @default(uuid()) @db.Uuid
  serviceRequestId String         @db.Uuid
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  // The final, publicly-fetchable URL this backend itself issued via
  // StoragePort.createUploadUrl() (see ServiceRequestAttachmentUploadRef
  // below) — same "just a URL string" posture as CustomerProfile.photoUrl,
  // except this one is always one this backend generated, never an
  // arbitrary client-supplied URL.
  url              String
  // Not exposed in GraphQL (the GOS-38 contract only exposes id/url/
  // createdAt) — only used to keep the output array's order stable and
  // independent of createdAt (which can tie within the same millisecond for
  // attachments created in the same batch). Internal ordering detail, not a
  // product field.
  order            Int            @default(0)
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
}

// Pre-reserved upload slot — the "ref" a client receives from
// requestServiceRequestAttachmentUploadUrl and later resubmits in
// PublishServiceRequestInput.attachmentUploadRefs. No prior "GOS-16"
// pre-signed-upload pattern exists anywhere in this codebase to reuse (see
// the GOS-38 plan's "Hallazgo crítico" section) — this table is the
// mechanism that gives ownership/expiration/single-use guarantees to that
// flow, designed from scratch, following only this codebase's general
// Port/Adapter convention (see src/service-requests/ports/storage.port.ts).
enum ServiceRequestAttachmentUploadRefStatus {
  PENDING
  CONSUMED
}

model ServiceRequestAttachmentUploadRef {
  id               String                                  @id @default(uuid()) @db.Uuid
  userId           String                                  @db.Uuid
  user             User                                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey       String
  fileUrl          String
  status           ServiceRequestAttachmentUploadRefStatus @default(PENDING)
  expiresAt        DateTime
  consumedAt       DateTime?
  // Set only once this ref is actually consumed by publishServiceRequest.
  // SetNull (not Cascade/Restrict): if a ServiceRequest were ever hard-deleted
  // in the future, this historical upload-ref row should survive with its
  // link cleared, not disappear or block the delete.
  serviceRequestId String?                                 @db.Uuid
  serviceRequest   ServiceRequest?                         @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  createdAt        DateTime                                @default(now())

  // Supports the ownership+status check publishServiceRequest does for
  // every submitted ref, and a future cleanup job for stale PENDING refs.
  @@index([userId, status])
}

// Identity Verification (Didit integration) — DEC-006's own "open question"
// (automated KYC). See `src/identity-verification/` for the full
// Port/Registry/Adapter design. `User.accountStatus` (PENDING_APPROVAL ->
// APPROVED|REJECTED) remains the ONE source of truth the rest of the app
// gates on — this table only records the verification ATTEMPTS that can
// drive that transition, automatically (via the Didit webhook) or as
// context for the pre-existing manual `updateUserAccount` admin path.

// Detected document type, reported by Didit's hosted flow AFTER capture
// (never declared by the user beforehand) — UNKNOWN is the default until a
// webhook actually reports one.
enum IdentityDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  FOREIGN_ID
  UNKNOWN
}

enum IdentityVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model IdentityVerification {
  id      String      @id @default(uuid()) @db.Uuid
  userId  String      @db.Uuid
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The country resolved server-side (from the owning User's
  // CustomerProfile/ProfessionalProfile) at the moment this attempt was
  // started — never client-supplied. See `StartIdentityVerificationService`.
  country CountryCode

  // Free-text, not an enum — "didit" today; a second provider later is a
  // new string value, not a schema migration.
  provider          String  @default("didit")
  // Didit's own `session_id`, set once `createSession` succeeds. Also used
  // as this row's own `id` for `vendor_data` when the session is created —
  // see `StartIdentityVerificationService`.
  providerReference String?

  documentType         IdentityDocumentType       @default(UNKNOWN)
  documentCheckPassed  Boolean?
  biometricCheckPassed Boolean?
  status               IdentityVerificationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([provider, providerReference])
}

// GOS-30/31/32 — Platform-admin capability, Slice 1. These models are
// deliberately NOT part of the GoService domain model (no ServiceRequest/
// Quote/Engagement relationship) — they back an internal governance/config
// tool (feature flags, credentials, admin users, audit log), reachable only
// via the isolated `/admin/graphql` endpoint (see
// `src/platform-admin/platform-admin.module.ts`). Kept in the same
// `schema.prisma` file/database per ADR 0003 (single shared PostgreSQL
// database), but intentionally namespaced with an `Admin`/`Platform` prefix
// so they're never mistaken for consumer-domain entities.
//
// Field/model conventions mirror the rest of this schema: PascalCase
// models, camelCase fields, `@db.Uuid` ids, hash-at-rest tokens named
// `tokenHash @unique` (see `Session.tokenHash` above), `createdAt`/
// `updatedAt @updatedAt` pairs.

enum AdminUserStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum AdminSessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// The full permission catalog across all 4 planned slices (Slice 1 only
// ever grants/checks FEATURE_FLAGS_READ/WRITE in code — the rest exist now
// so `AdminRole` doesn't need a future migration when Slices 2-4 land).
enum Permission {
  FEATURE_FLAGS_READ
  FEATURE_FLAGS_WRITE
  CREDENTIALS_READ
  CREDENTIALS_WRITE
  ADMIN_USERS_MANAGE
  SESSIONS_READ
  AUDIT_LOG_READ
  // GOS-3x follow-up (2026-08-10) — gates `userAccounts`/`updateUserAccount`/
  // `forceUserAccountPasswordReset` (`src/platform-admin/user-accounts/`), a
  // full read/write ADMIN surface over the consumer `User` table. NOT the
  // same thing as the still-unbuilt `ADMIN_USERS_MANAGE`-guarded, future
  // "Slice 3" admin-to-admin invite management (a different concept:
  // managing OTHER ADMINS, reserved for `adminUsers`/`AdminInvite` naming) —
  // see ADR 0005's dedicated section on this feature for the disambiguation.
  USER_ACCOUNTS_READ
  USER_ACCOUNTS_WRITE
  // GOS-3x follow-up (soft-delete, 2026-08-10; REPLACED by hard-delete,
  // 2026-08-11 — explicit human authorization, see ADR 0005's Tenth round)
  // — gates `deleteUserAccount`/`bulkDeleteUserAccounts`, which now
  // PERMANENTLY erase the target `User` row (and, via `onDelete: Cascade`,
  // every `Session`/`EmailVerificationCode`/`PasswordResetCode`/
  // `CustomerProfile`/`ProfessionalProfile` it owns). Deliberately its OWN
  // permission, NOT folded into `USER_ACCOUNTS_WRITE`: an irreversible
  // full account erasure is more consequential than editing a field, and is
  // granted to `SUPER_ADMIN` ONLY — see `scripts/bootstrap-super-admin.ts`
  // and ADR 0005's dedicated section on this decision. `CONFIG_MANAGER`
  // does NOT get this permission, even though it already holds
  // `USER_ACCOUNTS_WRITE`. Available in EVERY environment, not gated by
  // `NODE_ENV` — a deliberate, explicit human decision (this is a
  // development/testing convenience tool, not a production data-retention
  // mechanism; see ADR 0005).
  USER_ACCOUNTS_DELETE
  // GOS-38 follow-up (2026-08-18) — gates the read-only admin surface over
  // ServiceRequest (`serviceRequests`/`serviceRequestDetail`, see
  // `src/platform-admin/service-requests/`). Read-only, mirroring
  // USER_ACCOUNTS_READ's own semantics.
  SERVICE_REQUESTS_READ
  // GOS-38 follow-up (2026-08-18, same day) — gates
  // `eligibleServiceRequestCustomers`/`createServiceRequestForCustomer`: an
  // admin can create a ServiceRequest on behalf of a Customer, but ONLY one
  // whose account is already APPROVED (identity-validated) and who has a
  // CustomerProfile — enforced server-side by
  // `CreateServiceRequestForCustomerService`, not just by what the picker
  // shows. Separate from SERVICE_REQUESTS_READ, mirroring
  // USER_ACCOUNTS_READ/USER_ACCOUNTS_WRITE's own split — still no
  // "edit"/"cancel" capability exists from the admin panel; this is
  // create-only.
  SERVICE_REQUESTS_WRITE
  // Category-catalog-management follow-up (2026-08-18) — gates the
  // read-only `adminCategories` query (`src/platform-admin/categories/`).
  // Separate from SERVICE_REQUESTS_READ: reading the category catalog for
  // management purposes is a distinct capability from reading
  // ServiceRequests, even though `serviceRequestCategories` (a different,
  // narrower query gated by SERVICE_REQUESTS_WRITE) also happens to read
  // this same table for an unrelated purpose (the create-ServiceRequest
  // picker).
  CATEGORIES_READ
  // Category-catalog-management follow-up (2026-08-18, same day) — gates
  // `createCategory`/`updateCategory`/`deleteCategory`. The catalog is no
  // longer purely seed-only (`prisma/seed.ts` remains how it's FIRST
  // populated, but an admin can now create/rename/reorder/delete entries
  // from the panel).
  CATEGORIES_WRITE
  // Quotes admin grid follow-up (GOS-41 admin surface, 2026-08-19) — gates
  // the read-only admin surface over Quote (`quotes`/`quoteDetail`, see
  // `src/platform-admin/quotes/`). Read-only, mirroring
  // SERVICE_REQUESTS_READ's own semantics — there is no
  // QUOTES_WRITE: unlike ServiceRequest, there is no sensible admin analog
  // to an admin fabricating a Quote on behalf of a Professional, so this
  // grid never grew a "create on behalf of" mutation the way
  // createServiceRequestForCustomer did.
  QUOTES_READ
  // Quote Negotiation admin audit surface follow-up (GOS-53, 2026-08-21) —
  // gates the read-only `adminQuoteNegotiationThread` query
  // (`src/platform-admin/quote-negotiation/`). A genuinely NEW, dedicated
  // permission — NOT a reuse of `SERVICE_REQUESTS_READ` (the first-round
  // ticket-literal choice) nor `QUOTES_READ` (the sibling admin Quote-read
  // surface's own permission): auditing a Quote's negotiation thread,
  // including its unredacted price proposals, is its own distinct
  // capability, deserving its own grant/withhold decision independent of
  // either.
  QUOTE_NEGOTIATION_READ
  // Chat de Coordinación admin audit surface (GOS-46, 2026-08-21) — gates
  // the read-only `adminEngagementChatThread` query
  // (`src/platform-admin/engagement-chat/`). A genuinely NEW, dedicated
  // permission — deliberately NOT `SERVICE_REQUESTS_READ` (this ticket's own
  // instructions explicitly called out that reuse as the wrong precedent)
  // nor `QUOTE_NEGOTIATION_READ` (the sibling admin negotiation-thread
  // read surface's own permission): reading a private Engagement
  // coordination conversation is a distinct, more sensitive capability —
  // same "its own dedicated permission" reasoning QUOTE_NEGOTIATION_READ's
  // own comment above already establishes for its sibling surface.
  ENGAGEMENT_CHAT_READ
  // Appointment (Coordinación de Visita) admin audit surface (GOS-59,
  // 2026-08-24) — gates the read-only `adminAppointmentsByEngagement` query
  // (`src/platform-admin/appointments/`). A genuinely NEW, dedicated
  // permission — same "its own dedicated permission, not reused from a
  // sibling read permission" reasoning already documented for
  // `QUOTE_NEGOTIATION_READ`/`ENGAGEMENT_CHAT_READ` above: auditing
  // Appointment scheduling data is its own distinct capability.
  APPOINTMENTS_READ
}

// Fixed, code-seeded catalog for Slice 1 (see
// `scripts/bootstrap-super-admin.ts`) — not creatable via any GraphQL
// mutation yet. Whether `AdminRole` becomes admin-creatable later is an
// open question, flagged for the ADR.
model AdminRole {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  adminUsers AdminUser[]
}

model AdminUser {
  id          String @id @default(uuid()) @db.Uuid
  email       String @unique
  displayName String

  // Never exposed via GraphQL — mirrors `User.passwordHash`. Nullable to
  // leave room for the Slice-3 invite flow (INVITED admins have no password
  // yet); Slice 1's bootstrap script always sets it immediately.
  passwordHash String?

  roleId String    @db.Uuid
  role   AdminRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  status AdminUserStatus @default(INVITED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                AdminSession[]
  auditLogs               AdminAuditLog[]
  // Slice 3 consolidation — `PlatformSetting.updatedByAdminUser`'s inverse
  // relation must live on `AdminUser`, since Prisma requires both sides of a
  // relation declared together. Replaces the former `updatedFeatureFlags`/
  // `updatedPlatformCredentials` (now merged into one `PlatformSetting`
  // table — see that model's own header comment).
  updatedPlatformSettings PlatformSetting[]
  // Roles/admin-user management follow-up (2026-08-19) — every AdminInvite
  // ever issued for this AdminUser (a fresh one on `inviteAdminUser`,
  // possibly more via `resendAdminInvite`). See AdminInvite's own header
  // comment below.
  invites                 AdminInvite[]

  @@index([status])
}

// Roles/admin-user management follow-up (2026-08-19) — the invite/accept
// mechanism backing `inviteAdminUser`/`resendAdminInvite`/`acceptAdminInvite`.
// Structurally close to `EmailVerificationCode`/`PasswordResetCode`
// (single-use, expiresAt/consumedAt/invalidatedAt), but deliberately an
// OPAQUE TOKEN + hash (mirrors `AdminSession.tokenHash`'s hash-at-rest
// pattern), NOT a 6-digit code: this is delivered by LINK to someone not yet
// authenticated in any client, so a typed code makes no sense here — see
// `AcceptAdminInviteService`'s own header comment for the full anti-
// enumeration design this backs.
model AdminInvite {
  id            String    @id @default(uuid()) @db.Uuid
  adminUserId   String    @db.Uuid
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([adminUserId, consumedAt, invalidatedAt])
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  // SHA-256 hash of the opaque session token — same hash-at-rest pattern as
  // `Session.tokenHash`, generated/hashed by this module's OWN
  // `admin-session-token.util.ts` (zero shared code with
  // `src/auth/services/session-token.util.ts`).
  tokenHash String             @unique
  status    AdminSessionStatus @default(ACTIVE)

  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  lastActivityAt DateTime  @default(now())
  revokedAt      DateTime?

  @@index([adminUserId, status])
}

// GOS-30/31/32 — Platform-admin capability. `PlatformSetting` is a Slice-3
// consolidation of what used to be two separate models, `FeatureFlag`
// (Slice 1) and `PlatformCredential` (Slice 2) — merged into ONE
// Magento-`core_config_data`-style table (a path + a value, encryption
// applied per-row via `isEncrypted`, not via a structurally separate model)
// at explicit, informed human request, after being told the concrete
// trade-off this implies: a per-row "remember to encrypt" flag is weaker
// than a structurally-separate encrypted-only model, because nothing at the
// TYPE level stops a future row from being mis-flagged. The guardrails below
// (a DB CHECK constraint enforcing the encrypted-vs-plain column shape, and
// `PlatformSettingFieldResolver`'s structural GraphQL-layer guard — see
// `src/platform-admin/platform-settings/platform-setting-field.resolver.ts`)
// exist SPECIFICALLY to make the accepted risk as safe as this architecture
// allows, not to pretend the risk doesn't exist.
//
// GOS-3x follow-up (2026-08-08): the former `isPublic` column (a manual,
// per-row "expose this via `platformPublicSettings`?" flag) was REMOVED —
// see `20260808220000_drop_platform_setting_is_public`. After discussion,
// a separate manual flag was judged unnecessary complexity: whether a
// setting is ENCRYPTED is the only gate that matters. A non-encrypted
// value is, by definition, not a secret, so it is now automatically safe to
// expose — see `PlatformSettingsRepository.findPublicSettings()`'s
// `WHERE isEncrypted = false` filter.
//
// GOS-3x follow-up #2 (2026-08-10) — REVERSAL, human-approved: `isPublic`
// is BACK, as an independent, default-OFF opt-in — see
// `20260810103000_reintroduce_platform_setting_is_public`. Driving reason:
// more credential-shaped (`isEncrypted: true`) settings are coming soon,
// and "not encrypted" was being used as a proxy for "meant to be shown to
// mobile" — that stopped holding once a non-secret setting that is NOT
// meant to be mobile-facing (backend/admin-only config, still not a
// secret) became a realistic case rather than a hypothetical. See the
// `isPublic` field's own comment below, and ADR 0005's dedicated section on
// this reversal, for the full reasoning.
//
// `key` follows a dot-namespaced path convention, e.g.
// `customer.social-login.google.enabled` — `<audience>.<area>.<...>.<leaf>`
// — adopted (GOS-30/31/32 Slice 2) so the admin panel can group related
// settings by path prefix (see `admin-panel/js/settings.js`) and so a
// boolean flag and a related credential share a predictable, related key
// shape (`customer.social-login.google.enabled` /
// `customer.social-login.google.client-id`).
enum PlatformSettingValueType {
  BOOLEAN
  STRING
  NUMBER
}

model PlatformSetting {
  id          String                   @id @default(uuid()) @db.Uuid
  key         String                   @unique
  description String
  valueType   PlatformSettingValueType

  // Per-row encryption flag — see this model's own header comment for why
  // this is a deliberate, accepted trade-off, not an oversight. Also the
  // ONLY gate deciding whether `platformConfig` (the
  // UNAUTHENTICATED, consumer-facing `/graphql` query — see
  // `src/platform-admin/platform-settings/public/`) may return this row:
  // every `isEncrypted: false` row is automatically public, no separate
  // manual flag — see `PlatformSettingsRepository.findPublicSettings()`.
  isEncrypted Boolean @default(false)

  // Independent of `isEncrypted` — answers a DIFFERENT question. Defaults
  // to `false`: a brand-new setting is backend/admin-only by default, even
  // when it isn't a secret, unless someone deliberately opts it in.
  // `isEncrypted: true` is a HARD VETO over this: a row can never be both
  // encrypted AND public — enforced structurally by the
  // `platform_setting_encrypted_not_public_check` CHECK constraint (see the
  // migration), and defensively at the application/DTO validation layer
  // (`SetPlatformSettingService`) as the first line of defense with a
  // clearer error message. `platformConfig` (the UNAUTHENTICATED,
  // consumer-facing `/graphql` query) requires BOTH `isEncrypted: false`
  // AND `isPublic: true` — see
  // `PlatformSettingsRepository.findPublicSettings()`.
  isPublic Boolean @default(false)

  // Populated ONLY when isEncrypted = false — a DB CHECK constraint
  // (`platform_setting_encrypted_shape_check`, see the migration) makes any
  // other combination physically impossible to persist, not just
  // discouraged by convention.
  value String?

  // Populated ONLY when isEncrypted = true (mirrors the former
  // `PlatformCredential` columns exactly — same AES-256-GCM adapter,
  // unchanged: `src/platform-admin/platform-settings/adapters/aes-gcm-credential-encryption.adapter.ts`).
  // Plaintext is NEVER stored here or anywhere else; decrypted only in
  // memory, only by `PlatformSettingPort.getDecryptedValue` (the one
  // legitimate place plaintext exists at runtime).
  ciphertext    Bytes?
  iv            Bytes?
  authTag       Bytes?
  // e.g. "termina en •••1234" — never the real value, never reversible back
  // to it on its own. Populated ONLY when isEncrypted = true (same CHECK
  // constraint as above).
  maskedPreview String?
  // Free-text (GOOGLE, APPLE, ...), deliberately NOT an enum — avoids a
  // schema migration every time a new provider/credential is added. Only
  // meaningful when isEncrypted = true; left null otherwise.
  provider      String?

  updatedByAdminUserId String?    @db.Uuid
  updatedByAdminUser   AdminUser? @relation(fields: [updatedByAdminUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id               String    @id @default(uuid()) @db.Uuid
  actorAdminUserId String    @db.Uuid
  actorAdminUser   AdminUser @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict)

  // e.g. "FEATURE_FLAG_SET", "ADMIN_USER_REVOKED".
  action     String
  // e.g. "FeatureFlag", "PlatformCredential", "AdminUser".
  targetType String
  targetKey  String

  // Structured detail — MUST NEVER contain credential plaintext/ciphertext
  // (see the Slice-2 `PlatformCredential` design note in the platform-admin
  // implementation plan).
  metadata Json?

  occurredAt DateTime @default(now())

  @@index([targetType, occurredAt])
  @@index([actorAdminUserId])
}
