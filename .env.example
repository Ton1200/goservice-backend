# GoService backend — local environment variables (template, no real values)
#
# Copy this file to `.env` (git-ignored — see .gitignore) and fill in your
# own local values. Nothing in this file is a real secret.
#
# Pilot scope note: this backend uses the plain `pg` driver directly (no
# ORM) to connect to PostgreSQL — see goservice-docs/architecture/backend.md
# and ADR 0003 (goservice-docs/architecture/adr/0003-postgresql-primary-database.md)
# for why the ORM/persistence-library choice remains open and is NOT decided
# by this pilot.

# HTTP port the NestJS/GraphQL server listens on.
PORT=3000

# --- PostgreSQL connection (plain `pg` Pool — pilot only, no ORM) ---

# Matches the local pilot database documented in
# goservice-docs/architecture/infrastructure.md ("Local PostgreSQL — pilot
# provisioning"). Adjust if your local instance differs.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=goservice_dev
DATABASE_USER=goservice_dev

# Local-dev-only placeholder — replace with your own local password.
# NEVER commit a populated `.env` with a real password.
DATABASE_PASSWORD=example_password_do_not_use

# Max connections in the `pg` Pool.
DATABASE_POOL_MAX=10
